diff --git a/dlls/dcomp/wine_dxgi_composition.h b/dlls/dcomp/wine_dxgi_composition.h
new file mode 100644
index 0000000..cc166b0
--- /dev/null
+++ b/dlls/dcomp/wine_dxgi_composition.h
@@ -0,0 +1,22 @@
+#ifndef WINE_DXGI_COMPOSITION_H
+#define WINE_DXGI_COMPOSITION_H
+
+#include <unknwn.h>
+
+static const GUID IID_IWineDXGICompositionBinding = {0xf20b126a, 0xb535, 0x4a7e,
+    {0x98, 0x53, 0xf8, 0x97, 0xe7, 0x62, 0x91, 0x45}};
+
+#undef INTERFACE
+#define INTERFACE IWineDXGICompositionBinding
+DECLARE_INTERFACE_(IWineDXGICompositionBinding, IUnknown)
+{
+    STDMETHOD(QueryInterface)(THIS_ REFIID iid, void **out) PURE;
+    STDMETHOD_(ULONG, AddRef)(THIS) PURE;
+    STDMETHOD_(ULONG, Release)(THIS) PURE;
+    STDMETHOD(BindTarget)(THIS_ HWND hwnd, UINT64 binding_id) PURE;
+    STDMETHOD(UnbindTarget)(THIS_ UINT64 binding_id) PURE;
+};
+
+#undef INTERFACE
+
+#endif
diff --git a/dlls/dcomp/composition_binding.c b/dlls/dcomp/composition_binding.c
new file mode 100644
index 0000000..32a3e64
--- /dev/null
+++ b/dlls/dcomp/composition_binding.c
@@ -0,0 +1,181 @@
+struct dcomp_binding
+{
+    struct dcomp_binding *next;
+    IUnknown *content;
+    IUnknown *identity;
+    IWineDXGICompositionBinding *iface;
+    HWND hwnd;
+    UINT64 id;
+};
+
+UINT WINAPI wine_dcomp_get_composition_binding_version(void)
+{
+    return 1;
+}
+
+static HRESULT dcomp_binding_unbind(struct dcomp_binding *binding)
+{
+    return binding->iface->lpVtbl->UnbindTarget(binding->iface, binding->id);
+}
+
+static void dcomp_bindings_free(struct dcomp_binding *bindings, BOOL unbind)
+{
+    struct dcomp_binding *next;
+
+    while (bindings)
+    {
+        next = bindings->next;
+        if (bindings->iface)
+        {
+            if (unbind) dcomp_binding_unbind(bindings);
+            bindings->iface->lpVtbl->Release(bindings->iface);
+        }
+        if (bindings->identity) IUnknown_Release(bindings->identity);
+        IUnknown_Release(bindings->content);
+        free(bindings);
+        bindings = next;
+    }
+}
+
+static HRESULT dcomp_snapshot_visual(struct dcomp_visual *visual, struct dcomp_target *target,
+        struct dcomp_binding **bindings, unsigned int depth)
+{
+    struct dcomp_binding *binding;
+    SIZE_T index;
+    HRESULT hr;
+
+    if (depth > 256) return E_INVALIDARG;
+    if (visual->content)
+    {
+        if (!(binding = calloc(1, sizeof(*binding)))) return E_OUTOFMEMORY;
+        binding->content = visual->content;
+        IUnknown_AddRef(binding->content);
+        binding->hwnd = target->hwnd;
+        binding->id = target->id;
+        binding->next = *bindings;
+        *bindings = binding;
+    }
+    for (index = 0; index < visual->child_count; ++index)
+    {
+        hr = dcomp_snapshot_visual(dcomp_visual_from_iface(visual->children[index]), target, bindings, depth + 1);
+        if (FAILED(hr)) return hr;
+    }
+    return S_OK;
+}
+
+static BOOL dcomp_binding_matches(struct dcomp_binding *left, struct dcomp_binding *right)
+{
+    return left->identity == right->identity && left->id == right->id && left->hwnd == right->hwnd;
+}
+
+static BOOL dcomp_binding_contains(struct dcomp_binding *bindings, struct dcomp_binding *binding)
+{
+    while (bindings)
+    {
+        if (dcomp_binding_matches(bindings, binding)) return TRUE;
+        bindings = bindings->next;
+    }
+    return FALSE;
+}
+
+static HRESULT dcomp_resolve_bindings(struct dcomp_binding **bindings)
+{
+    struct dcomp_binding **entry = bindings, *binding, *previous;
+    HRESULT hr;
+
+    while ((binding = *entry))
+    {
+        hr = IUnknown_QueryInterface(binding->content, &IID_IWineDXGICompositionBinding, (void **)&binding->iface);
+        if (hr == E_NOINTERFACE)
+        {
+            *entry = binding->next;
+            binding->next = NULL;
+            dcomp_bindings_free(binding, FALSE);
+            continue;
+        }
+        if (FAILED(hr)) return hr;
+        hr = IUnknown_QueryInterface(binding->content, &IID_IUnknown, (void **)&binding->identity);
+        if (FAILED(hr)) return hr;
+        for (previous = *bindings; previous != binding; previous = previous->next)
+        {
+            if (previous->identity == binding->identity || previous->hwnd == binding->hwnd)
+            {
+                if (!dcomp_binding_matches(previous, binding)) return E_INVALIDARG;
+                break;
+            }
+        }
+        if (previous != binding)
+        {
+            *entry = binding->next;
+            binding->next = NULL;
+            dcomp_bindings_free(binding, FALSE);
+            continue;
+        }
+        entry = &binding->next;
+    }
+    return S_OK;
+}
+
+static HRESULT dcomp_commit(struct dcomp_device *device)
+{
+    struct dcomp_binding *bindings = NULL, *binding;
+    struct dcomp_target *target;
+    UINT64 revision;
+    HRESULT hr = S_OK;
+
+    if (!TryEnterCriticalSection(&device->commit_cs)) return E_PENDING;
+    if (device->committing)
+    {
+        LeaveCriticalSection(&device->commit_cs);
+        return E_PENDING;
+    }
+    device->committing = TRUE;
+    EnterCriticalSection(&dcomp_target_cs);
+    revision = dcomp_scene_revision;
+    for (target = dcomp_targets; target; target = target->next)
+    {
+        if (target->device != device || !target->root) continue;
+        hr = dcomp_snapshot_visual(dcomp_visual_from_iface(target->root), target, &bindings, 0);
+        if (FAILED(hr)) break;
+    }
+    LeaveCriticalSection(&dcomp_target_cs);
+    if (FAILED(hr)) goto done;
+    if (FAILED(hr = dcomp_resolve_bindings(&bindings))) goto done;
+    EnterCriticalSection(&dcomp_target_cs);
+    if (revision != dcomp_scene_revision) hr = E_PENDING;
+    LeaveCriticalSection(&dcomp_target_cs);
+    if (FAILED(hr)) goto done;
+    for (binding = device->bindings; binding; binding = binding->next)
+    {
+        if (dcomp_binding_contains(bindings, binding)) continue;
+        if (FAILED(hr = dcomp_binding_unbind(binding))) goto rollback;
+    }
+    for (binding = bindings; binding; binding = binding->next)
+    {
+        if (dcomp_binding_contains(device->bindings, binding)) continue;
+        hr = binding->iface->lpVtbl->BindTarget(binding->iface, binding->hwnd, binding->id);
+        TRACE("content %p, target %s, hwnd %p, hr %#lx.\n", binding->identity,
+                wine_dbgstr_longlong(binding->id), binding->hwnd, hr);
+        if (FAILED(hr)) goto rollback;
+    }
+    EnterCriticalSection(&dcomp_target_cs);
+    if (revision != dcomp_scene_revision) hr = E_PENDING;
+    if (SUCCEEDED(hr))
+    {
+        binding = device->bindings;
+        device->bindings = bindings;
+        bindings = binding;
+    }
+    LeaveCriticalSection(&dcomp_target_cs);
+    if (SUCCEEDED(hr)) goto done;
+rollback:
+    for (binding = bindings; binding; binding = binding->next)
+        dcomp_binding_unbind(binding);
+    dcomp_bindings_free(device->bindings, TRUE);
+    device->bindings = NULL;
+done:
+    dcomp_bindings_free(bindings, FALSE);
+    device->committing = FALSE;
+    LeaveCriticalSection(&device->commit_cs);
+    return hr;
+}
